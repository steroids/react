{
	"compilerOptions": {
	  "jsx": "react-jsx",
	  "lib": ["dom", "es2020.Intl"],
	  "experimentalDecorators": true,
	  "esModuleInterop": true,
	  "baseUrl": ".",
	  "declaration": true,
	  "isolatedModules": true,
	  "outDir": "./dist",
	  "skipLibCheck": true,
	  "paths": {
		 "@steroidsjs/bootstrap/*": [
			"../react-bootstrap/src/*"
		 ]
	  }
	},
	"include": [
		"src/**/*",
		"tests/**/*"
	]
 }
